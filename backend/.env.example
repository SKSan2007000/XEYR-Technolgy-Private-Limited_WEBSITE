# ==============================================================================
# XEYR TECHNOLOGIES PRIVATE LIMITED - SAFE PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# INSTRUCTIONS:
# 1. Duplicate this template as '.env' in the 'backend/' directory.
# 2. Never commit your populated '.env' file or secret credentials to source control.
# 3. For live deployments, supply these environment variables directly in your
#    hosting provider's dashboard (e.g. Render, Railway, DigitalOcean App Platform, AWS).
# ==============================================================================

# Core Django Security
# Generate a new 50+ character random key for production (e.g. using python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=xeyr-secure-production-secret-key-change-in-production-2026-xyz
DEBUG=False
# Comma-separated list of domains and IP addresses allowed to serve this app:
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com,localhost,127.0.0.1

# Canonical URLs (Main Company Website vs Events Portal Separation)
# PUBLIC_BASE_URL is the primary root domain for public links and QR code resolution:
PUBLIC_BASE_URL=https://yourdomain.com
# Main company website home destination (returned to when clicking the XEYR logo or 'Visit Our Website'):
COMPANY_WEBSITE_URL=https://yourdomain.com/
# Events Portal dedicated route:
EVENTS_PORTAL_URL=https://yourdomain.com/events/

# Database Configuration (PostgreSQL 14+ / 17 recommended)
# Set USE_SQLITE=True ONLY for emergency offline development if PostgreSQL is unavailable
USE_SQLITE=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=xeyr_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# CORS & CSRF Security Policies
# In production, set CORS_ALLOW_ALL_ORIGINS=False and explicitly list approved origins:
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com

# Production HTTPS & Cookie Defenses
# Set these to True once HTTPS SSL certificates are provisioned on your domain:
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Email Integration (Transactional notifications, certificates, subscriber announcements)
# For local testing, use: django.core.mail.backends.console.EmailBackend
# For live production delivery, use: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=xeyrtechnologies@gmail.com
# Generate a Google App Password from: https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=your_16_character_app_password_here
DEFAULT_FROM_EMAIL="XEYR Technologies <xeyrtechnologies@gmail.com>"
NOTIFICATION_RECIPIENT_EMAIL=xeyrtechnologies@gmail.com

# File Storage & Upload Protection
DATA_UPLOAD_MAX_MEMORY_SIZE=52428800
FILE_UPLOAD_MAX_MEMORY_SIZE=52428800
MAX_UPLOAD_SIZE_MB=50
PROTECTED_ASSETS_DIR=private_assets
HANDOVER_ARCHIVES_DIR=handover_archives

# Razorpay Payment Gateway Integration
# Generate API Keys from: Razorpay Dashboard -> Account & Settings -> API Keys
# Use 'rzp_test_...' for test sandbox, 'rzp_live_...' for real currency transactions:
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
# Webhook Secret from: Razorpay Dashboard -> Webhooks:
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere
