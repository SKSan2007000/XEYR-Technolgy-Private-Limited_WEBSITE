# ==============================================================================
# XEYR TECHNOLOGIES PRIVATE LIMITED - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `backend/.env` and update the values for your environment.

# Core Application Security
SECRET_KEY=xeyr-secure-production-secret-key-change-in-production-2026-xyz
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Supports either a Local PostgreSQL instance (localhost) or Hosted PostgreSQL 
# (e.g., Supabase, Neon, AWS RDS, Render, Railway, DigitalOcean).
USE_SQLITE=False
DB_ENGINE=django.db.backends.postgresql
DB_NAME=xeyr_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=True
# In production, restrict to:
# CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://xeyr.in

# ------------------------------------------------------------------------------
# Email System Integration (Transactional & Event Notifications)
# ------------------------------------------------------------------------------
# Use console backend for safe local development; switch to SMTP in production.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=xeyrtechnologies@gmail.com
EMAIL_HOST_PASSWORD=your_google_app_password_here
DEFAULT_FROM_EMAIL="XEYR Technologies <xeyrtechnologies@gmail.com>"
NOTIFICATION_RECIPIENT_EMAIL=xeyrtechnologies@gmail.com

# ------------------------------------------------------------------------------
# File Uploads & Confidential Storage Limits
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
PROTECTED_ASSETS_DIR=private_assets
HANDOVER_ARCHIVES_DIR=handover_archives

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway Configuration (Test Mode Keys)
# ------------------------------------------------------------------------------
# Generate test keys from: Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere
